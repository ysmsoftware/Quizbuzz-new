###########################################
# APP CONFIG

NODE_ENV=development
APP_NAME=QuizBuzz
PORT=3005
BASE_URL=http://localhost:3005/api
DOMAIN=https://quiz.exmaple.com/
FRONTEND_URL=http://localhost:3000

# Ops app (billing portal / subscription plan catalog). If unset, defaults to
# http://localhost:3010 and getPlans() silently falls back to a static
# single "Free" plan when that's unreachable — set this explicitly in every
# deployed environment.
OPS_BASE_URL=https://ops.example.com

# Instance scaling


INSTANCE_ID=instance-1
INSTANCE_COUNT=10


###########################################
# DATABASE CONFIG
DATABASE_URL="postgresql://"
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_QUERY_TIMEOUT=15000

###########################################
# REDIS CONFIG
REDIS_HOST=localhost
REDIS_PORT=7015
REDIS_PASSWORD="your_redis_password"
REDIS_DB=0

# redis Pooling
REDIS_MAX_RETRIES=5
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# redis scaling
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=

# redis TTLs

QUIZ_SESSION_TTL=7200
HEARTBEAT_TTL=30
SOCKET_TOKEN_TTL=7200
OTP_TTL=300
IDEMPOTENCY_TTL=86400

###########################################
# WEBSOCKET CONFIG

WS_NAMESPACE=/quiz
WS_PATH=/socket.io
WS_HEARTBEAT_INTERVAL=15000
WS_CONNECTION_TIMEOUT=30000
WS_MAX_CONNECTIONS_PER_INSTANCE=1000

# ws reconnection
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=2000

###########################################
# AUTH CONFIG
JWT_ACCESS_SECRET="replace_with_your_jwt_access_secret"
JWT_REFRESH_SECRET="replace_with_your_jwt_refresh_secret"
JWT_RESET_SECRET="replace_with_your_jwt_reset_secret"
JWT_CONTACT_SECRET="replace_with_your_jwt_contact_secret"

JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800
JWT_CONTACT_TTL=900

###########################################
# cookie config
COOKIE_DOMAIN=.ysmquizbuzz.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

###########################################
# OTP CONFIG
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=5
OTP_SECRET=isuivviveivueuwicwccsnnneve

###########################################
# RATE LIMITING

RATE_LIMIT_WINDOW=600
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=10
RATE_LIMIT_OTP=5

###########################################
# QUEUE

QUEUE_REDIS_DB=1
QUEUE_PREFIX=quizbuzz

QUEUE_CONCURRENCY=50
QUEUE_RETRY_ATTEMPTS=5
QUEUE_BACKOFF_TYPE=exponential
QUEUE_BACKOFF_DELAY=5000

# Worker Scaling
WORKER_INSTANCES=5


###########################################
# PAYMENT (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_WEBHOOK_URL=https://quiz.example.com/api/payments/webhook

# Route payout fee split (config-driven, no magic numbers in code)
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_ROUTE_ONBOARDING_MODE=MANUAL
PLATFORM_COMMISSION_PERCENT=2
RAZORPAY_GATEWAY_FEE_PERCENT=2
RAZORPAY_GST_ON_FEE_PERCENT=18
RAZORPAY_ROUTE_TRANSFER_DELAY_MS=300000


###########################################
# MESSAGEING

# Email (nodemailer) 
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@example.com

# Whatsapp
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_API_KEY=your_aisensy_api_key


###########################################
# FEATURE FLAGS
ENABLE_PROCTORING=true
ENABLE_ANALYTICS=true
ENABLE_CERTIFICATES=true
ENABLE_NOTIFICATIONS=true

########################################
# ANALYTICS CONFIG
ANALYTICS_SNAPSHOT_INTERVAL=60
ANALYTICS_RETENTION_DAYS=30

########################################
# PUB/SUB CHANNELS
REDIS_PUBSUB_ENABLED=true
REDIS_PUBSUB_PREFIX=quizbuzz


########################################
# SCALING LIMITS

MAX_PARTICIPANTS_PER_CONTEST=10000
MAX_QUESTIONS_PER_CONTEST=200
MAX_CONCURRENT_CONTESTS=10

########################################
# SECURITY CONFIG

BCRYPT_SALT_ROUNDS=10
CORS_ALLOWED_ORIGINS=https://quiz.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOW_CREDENTIALS=true


########################################
# IDEMPOTENCY

IDEMPOTENCY_ENABLED=true

########################################
# FILE STORAGE (S3 / CDN)

STORAGE_PROVIDER=s3
S3_BUCKET=quizbuzz-bucket
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=


########################################
# PROCTORING CONFIG

PROCTORING_EVENT_THRESHOLD=5
PROCTORING_STRICT_MODE=true

########################################
# HEALTH & MONITORING

HEALTHCHECK_ENABLED=true
METRICS_ENABLED=true

########################################
# LOGGING

LOG_LEVEL=info
LOG_FORMAT=json

########################################
# TESTING / DEBUG FLAGS

ENABLE_DEBUG_LOGS=false
MOCK_PAYMENT=false

########################################
# TIMEOUTS
API_TIMEOUT=10000
DB_TIMEOUT=20000
REDIS_TIMEOUT=3000

########################################
# CONTEST CONTROL

QUIZ_AUTO_SUBMIT=true
QUIZ_TIME_WARNING_1=600
QUIZ_TIME_WARNING_2=300
QUIZ_TIME_WARNING_3=60

# Seconds a CONTEST_START / AUTO_SUBMIT timer job may fire ahead of the contest's
# current startTime/endTime before it is treated as stale (schedule was edited after
# the job was queued) and re-scheduled instead of executed.
QUIZ_TIMER_DRIFT_TOLERANCE=5

# Grace period (seconds) after a contest ends before participants who never joined
# are marked ABSENT. Lets submission workers flush and persist first.
QUIZ_MARK_ABSENT_DELAY=600

########################################
# MONITORING

SENTRY_DSN=https://your-sentry-dsn
APP_VERSION=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_FLUSH_AT=20
POSTHOG_FLUSH_INTERVAL=30000
