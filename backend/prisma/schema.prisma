generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum OrgMemberRole {
  OWNER        
  ADMIN        
  VIEWER        
}

enum ContestStatus {
  DRAFT         
  PUBLISHED     
  REGISTRATION_CLOSED 
  LIVE          
  EVALUATION    
  RESULTS_OUT   
  COMPLETED     
  CANCELLED    
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ParticipantStatus {
  PENDING_PAYMENT 
  REGISTERED    
  CHECKED_IN    
  IN_WAITING    
  IN_QUIZ       
  SUBMITTED     
  DISQUALIFIED  
  ABSENT 
}

enum PaymentStatus {
  CREATED
  PENDING       
  SUCCESS
  FAILED       
  CANCELLED
  REFUNDED      
}

enum PaymentProvider {
  RAZORPAY
  MANUAL       
  FREE        
}

enum PayoutAccountStatus {
  PENDING
  ACTIVE
  VERIFICATION_FAILED
  DISABLED
}

enum PayoutOnboardingMode {
  MANUAL
  API
}

enum RouteTransferStatus {
  PENDING
  PROCESSED
  FAILED
  REVERSED
}

enum SubmissionStatus {
  PENDING     
  SUBMITTED     
  EVALUATED     
  INVALIDATED   
}

enum CertificateStatus {
  PENDING    
  QUEUED
  GENERATING  
  GENERATED     
  FAILED        
  DELIVERED     
}

enum MessageChannel {
  WHATSAPP
  EMAIL
}

enum MessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
}

enum MessageTemplate {
  
  OTP_VERIFICATION_CODE
  BIRTHDAY_WISHES_YSM
  FEEDBACK_COLLECTION_MESSAGE
  CERTIFICATE_ISSUED
  REGISTRATION_SUCCESSFUL
  WORKSHOP_REMINDER_MESSAGE
  PAYMENT_CONFIRMATION_MESSAGE
  
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ORG_INVITE
  
  DISQUALIFICATION_NOTICE
  RESULTS_PUBLISHED
  CUSTOM
}

enum ViolationType {
  FACE_NOT_DETECTED
  MULTIPLE_FACES
  TAB_SWITCH
  FULLSCREEN_EXIT
  AUDIO_ANOMALY
  POOR_LIGHTING
  GAZE_AWAY
  WINDOW_BLUR
  SCREEN_RESIZE
  SNAPSHOT_START
  SNAPSHOT_MID_POINT
  SNAPSHOT_RANDOM
  SNAPSHOT_PRE_SUBMIT
}

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
}

enum OnboardingStep {
  NOT_STARTED  
  IDENTITY      
  USE_CASE      
  ATTRIBUTION   
  CONTACT_LOCALE 
  PLAN_SELECTION 
  COMPLETED     
}

enum OrgPrimaryUseCase {
  EDUCATIONAL_INSTITUTION
  COACHING_INSTITUTE
  CORPORATE_TRAINING
  RECRUITMENT_ASSESSMENT
  INDIVIDUAL_EDUCATOR
  COMMUNITY_CLUB
  PERSONAL
  OTHER
}

enum OrgSizeBucket {
  SIZE_1
  SIZE_2_10
  SIZE_11_50
  SIZE_51_200
  SIZE_200_PLUS
}

enum ExpectedContestVolume {
  RANGE_1_4
  RANGE_5_20
  RANGE_20_PLUS
  UNSURE
}

enum ExpectedParticipantVolume {
  RANGE_UNDER_100
  RANGE_100_500
  RANGE_500_2000
  RANGE_2000_PLUS
  UNSURE
}

enum AmbassadorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AmbassadorCampaignStatus {
  ACTIVE
  ARCHIVED
}

enum HeardAboutSource {
  GOOGLE_SEARCH
  SOCIAL_MEDIA
  LINKEDIN
  WORD_OF_MOUTH
  REFERRAL
  ADVERTISEMENT
  EVENT_CONFERENCE
  OTHER
}

// ORGANIZATION & MEMBERS  (multi-tenant root)

model Organization {
  id                   String         @id @default(ulid())
  name                 String
  slug                 String         @unique
  logoUrl              String?
  website              String?
  isActive             Boolean        @default(true)
  isDeleted            Boolean        @default(false)
  onboardingStep       OnboardingStep @default(NOT_STARTED)
  onboardingCompleted  Boolean        @default(false)
  onboardingCompletedAt DateTime?
  planSlug              String?
  planStatus             String?
  planLimitsCache     Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Relations
  profile              OrganizationProfile?
  members              OrgMember[]
  contests             Contest[]
  contacts             Contact[]
  prizes               Prize[]
  questionOptions      QuestionOption[]
  contestQuestions     ContestQuestion[]
  participants         Participant[]
  payments             Payment[]
  payoutAccount        OrganizationPayoutAccount?
  routeTransfers       PaymentRouteTransfer[]
  quizSessions         QuizSession[]
  submissions          Submission[]
  answers              Answer[]
  leaderboard          LeaderboardEntry[]
  certificates         Certificate[]
  certificateTemplates CertificateTemplate[]
  proctoringEvents     ProctoringEvent[]
  proctoringScores     ProctoringScore[]
  messageLogs          MessageLog[]
  scheduledJobs        ScheduledJob[]
  analyticsSnapshots   ContestAnalyticsSnapshot[]
  exportLogs           ExportLog[]
  planUsageCheckLogs   PlanUsageCheckLog[]
  ambassadors          Ambassador[]
  ambassadorCampaigns  AmbassadorCampaign[]
  ambassadorTypeAccess OrganizationAmbassadorTypeAccess[]

  @@index([slug])
  @@index([isActive, isDeleted])
  @@index([onboardingCompleted])   // ops-dashboard funnel queries
  @@map("organizations")
}

/**
 * Audit trail of every subscription-plan-limit check performed by
 * src/middlewares/plan-limit.middleware.ts, both allowed and blocked.
 * Feeds the ops-next "recent limit hits" panel and lets us answer
 * "how close is this org to its ceiling" without recomputing it from
 * scratch on every dashboard load. `ALLOWED` rows are pruned after ~90
 * days by a scheduled job; `BLOCKED` rows are kept indefinitely since
 * those are what the ops team actually needs history on.
 */
model PlanUsageCheckLog {
  id             String   @id @default(ulid())
  organizationId String
  limitType      String   // "contestsPerCycle" | "participantsPerContest" | "questionsPerContest" | "orgMembers"
  outcome        String   // "ALLOWED" | "BLOCKED"
  limitValue     Int?     // null = unlimited at the moment of this check
  currentValue   Int
  requestId      String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, limitType, createdAt])
  @@index([outcome, createdAt])
  @@map("plan_usage_check_logs")
}

model OrgMember {
  id             String        @id @default(ulid())
  organizationId String
  adminId        String
  role           OrgMemberRole @default(ADMIN)
  invitedAt      DateTime      @default(now())
  acceptedAt     DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  admin          Admin         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([organizationId, adminId])             // one membership per admin per org
  @@index([organizationId])
  @@index([adminId])
  @@map("org_members")
}

// ADMIN  (platform users who create/manage contests)

model Admin {
  id                String      @id @default(ulid())
  email             String      @unique
  passwordHash      String
  firstName         String
  lastName          String
  avatarUrl         String?
  isActive          Boolean     @default(true)
  isDeleted         Boolean     @default(false)
  emailVerified     Boolean     @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  memberships       OrgMember[]
  refreshTokens     AdminRefreshToken[]
  contestsCreated   Contest[]   @relation("ContestCreatedBy")
  exportLogs        ExportLog[]

  @@index([email])
  @@index([isActive, isDeleted])
  @@map("admins")
}

model AdminRefreshToken {
  id          String    @id @default(ulid())
  adminId     String
  tokenHash   String    @unique           // store hash of the token, not plaintext
  deviceInfo  String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

// CONTEST

model Contest {
  id                    String          @id @default(ulid())
  organizationId        String
  createdById           String
  title                 String
  slug                  String          // unique per org — see @@unique below
  description           String?
  details               String?         // rich text / markdown
  topics                String[]        // e.g. ["DSA", "System Design"]
  rules                 String[]        // array of rule strings
  paymentEnabled        Boolean         @default(false)
  paymentConfig         PaymentConfig?
  duration              Int             // quiz duration in minutes
  cutoffScore           Int?            // minimum score to pass (percentage)
  maxParticipants       Int?            // null = unlimited
  registrationDeadline  DateTime        // when registration closes
  startTime             DateTime        // when the quiz goes LIVE
  endTime               DateTime        // startTime + duration (computed, stored for queries)
  status                ContestStatus   @default(DRAFT)
  joinCode              String?         // OTP/ID users enter to verify at join
  allowResuming         Boolean         @default(true)
  shuffleQuestions      Boolean         @default(true)
  shuffleOptions        Boolean         @default(false)
  proctoringEnabled     Boolean         @default(true)
  showResultsAfter      Int             @default(24)  // hours after end before results published
  bannerImage           String?
  isDeleted             Boolean         @default(false)
  isArchived            Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  organization          Organization    @relation(fields: [organizationId], references: [id])
  createdBy             Admin           @relation("ContestCreatedBy", fields: [createdById], references: [id])
  prizes                Prize[]
  questions             ContestQuestion[]
  participants          Participant[]
  submissions           Submission[]
  leaderboard           LeaderboardEntry[]
  certificates          Certificate[]
  messageLog            MessageLog[]
  scheduledJobs         ScheduledJob[]
  payments              Payment[]
  proctoringScores      ProctoringScore[]
  exportLogs            ExportLog[]
  ambassadorCampaign    AmbassadorCampaign?

  @@unique([organizationId, slug])        // slug is unique within an org, not globally
  @@index([organizationId, status])
  @@index([startTime, status])
  @@index([registrationDeadline])
  @@index([isDeleted, status])
  @@index([organizationId, isArchived])
  @@map("contests")
}


model PaymentConfig {
  id            String      @id @default(uuid())
  contestId     String      @unique
  amount        Int         // Store in smallest currency unit (paise for INR)
  currency      String      @default("INR")
  description   String?     @db.Text

    contest     Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  
}

model Prize {
  id              String    @id @default(ulid())
  organizationId  String
  contestId       String
  rankFrom        Int       // e.g. 1
  rankTo          Int       // e.g. 3  (rankFrom=1, rankTo=3 = "1st to 3rd place")
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("INR")
  label           String?   // e.g. "Gold", "Silver", "Participation"
  benefits        String[]  // e.g. ["Certificate", "Internship opportunity"]
  createdAt       DateTime  @default(now())

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contest         Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  

  @@index([organizationId])
  @@index([contestId])
  @@map("prizes")
}

// QUESTION BANK


model Question {
  id                  String              @id @default(ulid())
  organizationId      String              // questions belong to an org's bank
  questionText        String
  difficulty          QuestionDifficulty
  hint                String?
  explanation         String?             // shown after contest ends
  tags                String[]            // topics / concepts
  isDeleted           Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  options             QuestionOption[]
  contestQuestions    ContestQuestion[]
  answers             Answer[]

  @@index([organizationId, difficulty])
  @@index([organizationId, isDeleted])
  @@map("questions")
}

model QuestionOption {
  id              String    @id @default(ulid())
  organizationId  String
  questionId      String
  text            String
  position        Int       // 0, 1, 2, 3 (or 4) — display order
  isCorrect       Boolean   @default(false)

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  question        Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([questionId])
  @@map("question_options")
}

// Join table: Contest ↔ Question (many-to-many)
// Stores the order and which questions are assigned to each contest
model ContestQuestion {
  id              String    @id @default(ulid())
  organizationId  String
  contestId       String
  questionId      String
  position        Int       // display order within this contest
  marks           Int       @default(1)   // marks for correct answer
  negativeMark    Decimal   @default(0) @db.Decimal(4, 2) // negative marks for wrong

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contest         Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  question        Question     @relation(fields: [questionId], references: [id])

  @@unique([contestId, questionId])
  @@unique([contestId, position])
  @@index([organizationId])
  @@index([contestId])
  @@index([questionId])
  @@map("contest_questions")
}

// CONTACT  (deduplicated user identity)
// One Contact can participate in many contests — no duplicate rows per contest

model Contact {
  id                String        @id @default(ulid())
  organizationId    String
  email             String
  phone             String?       // E.164 format: +919876543210
  firstName         String
  lastName          String?
  college           String?
  department        String?
  city              String?
  state             String?
  isDeleted         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  participants  Participant[] // one contact → many contest participations
  payments      Payment[]

  organization  Organization    @relation(fields: [organizationId], references: [id])
  
  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([email])
  @@index([phone])
  @@map("contacts")
}

// PARTICIPANT  (Contact x Contest join — a registration)

model Participant {
  id              String            @id @default(ulid())
  organizationId  String
  contactId       String
  contestId       String
  registrationRef String            @unique   // human-readable: QB-2024-00001
  status          ParticipantStatus @default(REGISTERED)
  joinedAt        DateTime?         // when they entered the quiz room
  checkedInAt     DateTime?         // when they verified with joinCode
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact           @relation(fields: [contactId], references: [id])
  contest         Contest           @relation(fields: [contestId], references: [id])
  payment         Payment?          // one-to-one (one payment per registration)
  submission      Submission?       // one-to-one
  leaderboard     LeaderboardEntry?
  certificate     Certificate?
  sessions        QuizSession[]
  proctoring      ProctoringEvent[]
  messages        MessageLog[]
  proctoringScores ProctoringScore[]

  referredByEnrollmentId String?
  referredByEnrollment   AmbassadorCampaignEnrollment? @relation("ReferredBy", fields: [referredByEnrollmentId], references: [id])

  @@unique([contactId, contestId])        // one registration per contact per contest
  @@index([organizationId])
  @@index([contestId, status])
  @@index([contactId])
  @@index([registrationRef])
  @@index([referredByEnrollmentId])
  @@map("participants")
}

// PAYMENT

model Payment {
  id                String          @id @default(ulid())
  organizationId    String
  contestId         String          // denormalized for fast queries
  participantId     String          @unique   // one payment per participant
  contactId         String
  amount            Int             // in paise 
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(RAZORPAY)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpayStatus    String?
  paidAt            DateTime?
  metadata          Json?           // store raw provider response for audit/debug
  attempts          Int             @default(1)
  failureReason     String?
  webhookConfirmed  Boolean       @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  isDeleted         Boolean         @default(false)

  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contest         Contest          @relation(fields: [contestId], references: [id])
  participant     Participant     @relation(fields: [participantId], references: [id])
  contact         Contact         @relation(fields: [contactId], references: [id])
  routeTransfer   PaymentRouteTransfer?

  @@index([organizationId])
  @@index([contactId])
  @@index([organizationId, contactId])
  @@index([participantId])
  @@index([contestId, status])
  @@index([contestId, createdAt])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status, createdAt])
  @@map("payments")
}

model OrganizationPayoutAccount {
  id                      String                @id @default(ulid())
  organizationId          String                @unique
  razorpayLinkedAccountId String?               @unique
  accountName             String
  accountEmail            String
  contactNumber           String?
  status                  PayoutAccountStatus   @default(PENDING)
  onboardingMode          PayoutOnboardingMode  @default(MANUAL)
  activatedAt             DateTime?
  statusReason            String?
  metadata                Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("organization_payout_accounts")
}

model PaymentRouteTransfer {
  id                      String               @id @default(ulid())
  organizationId          String
  paymentId               String               @unique
  razorpayPaymentId       String
  razorpayTransferId      String?              @unique
  razorpayLinkedAccountId String?
  grossAmount             Int
  platformFeeAmount       Int                  // platform commission only (config.payout.commissionPercent)
  gatewayFeeAmount        Int                  @default(0) // Razorpay TDR (config.payout.gatewayFeePercent)
  gstAmount               Int                  @default(0) // GST on the gateway fee (config.payout.gstPercent)
  transferAmount          Int                  // grossAmount - platformFeeAmount - gatewayFeeAmount - gstAmount
  currency                String               @default("INR")
  status                  RouteTransferStatus  @default(PENDING)
  failureReason           String?
  processedAt             DateTime?
  metadata                Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id])

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("payment_route_transfers")
}

// QUIZ SESSION  (device-level session tracking during live quiz)

model QuizSession {
  id                String    @id @default(ulid())
  organizationId    String
  participantId     String
  socketId          String?                     // current socket connection
  deviceFingerprint String?                   // browser fingerprint
  ipAddress         String?
  userAgent         String?
  isActive          Boolean   @default(true)
  startedAt         DateTime  @default(now())
  lastHeartbeatAt   DateTime  @default(now())
  endedAt           DateTime?
  currentQuestion   Int       @default(0)       // last known question index (0-based)
  createdAt         DateTime  @default(now())

  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant       Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([participantId, isActive])
  @@index([socketId])
  @@map("quiz_sessions")
}

// SUBMISSION  (final answer record — persisted from Redis at submit time)

model Submission {
  id              String            @id @default(ulid())
  organizationId  String
  participantId   String            @unique   // one submission per participant
  contestId       String            // denormalized
  status          SubmissionStatus  @default(PENDING)
  source          String            @default("MANUAL")
  submittedAt     DateTime?
  evaluatedAt     DateTime?

  // Scoring (filled by evaluation worker)
  totalQuestions  Int?
  attempted       Int?
  correct         Int?
  wrong           Int?
  skipped         Int?
  score           Decimal?          @db.Decimal(8, 2)
  percentage      Decimal?          @db.Decimal(5, 2)
  isPassed        Boolean?
  timeTakenSecs   Int?              // seconds from first question to submit
  timeTakenMs     Int?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant     Participant       @relation(fields: [participantId], references: [id])
  contest         Contest           @relation(fields: [contestId], references: [id])
  answers         Answer[]

  @@index([organizationId])
  @@index([contestId, status])
  @@index([contestId, score])             // for leaderboard queries
  @@index([participantId])
  @@map("submissions")
}

// Individual answer record — one row per question per submission
model Answer {
  id                  String    @id @default(ulid())
  organizationId      String
  submissionId        String
  questionId          String
  selectedOptionId    String?   // null = skipped
  isCorrect           Boolean?  // null until evaluated
  marksAwarded        Decimal?  @db.Decimal(4, 2)
  answeredAt          DateTime?

  // Relations
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission          Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question            Question     @relation(fields: [questionId], references: [id])

  @@unique([submissionId, questionId])    // one answer per question per submission
  @@index([organizationId])
  @@index([submissionId])
  @@index([questionId])
  @@map("answers")
}

// LEADERBOARD

model LeaderboardEntry {
  id              String    @id @default(ulid())
  organizationId  String
  contestId       String
  participantId   String    @unique   // one entry per participant
  rank            Int
  score           Decimal   @db.Decimal(8, 2)
  percentage      Decimal   @db.Decimal(5, 2)
  timeTakenSecs   Int
  timeTakenMs     Int?
  isPassed        Boolean   @default(false)
  prizeId         String?             // resolved prize bracket (nullable — not everyone wins)
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contest         Contest      @relation(fields: [contestId], references: [id])
  participant     Participant  @relation(fields: [participantId], references: [id])

  @@unique([contestId, rank])
  @@index([organizationId])
  @@index([contestId, rank])
  @@index([contestId, score])
  @@index([contestId, isPublished])
  @@map("leaderboard_entries")
}

// CERTIFICATE

model Certificate {
  id              String            @id @default(ulid())
  organizationId  String
  contestId       String
  participantId   String            @unique
  status          CertificateStatus @default(PENDING)
  fileUrl         String?           // S3/R2 URL after generation
  fileKey         String?           // S3 key for deletion/re-generation
  generatedAt     DateTime?
  deliveredAt     DateTime?
  metadata        Json?             // template parameters, rank, score, etc.
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contest         Contest           @relation(fields: [contestId], references: [id])
  participant     Participant       @relation(fields: [participantId], references: [id])

  @@index([organizationId])
  @@index([contestId, status])
  @@map("certificates")
}

model CertificateTemplate {
  id             String   @id @default(ulid())
  organizationId String
  name           String
  description    String?
  htmlContent    String   // raw HTML containing {{variable}} placeholders — stored inline, no S3 round trip needed to render
  variables      Json     // string[] — placeholder names detected at upload/update time; informational + used for the "unknown placeholder" warning in preview
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("certificate_templates")
}

// PROCTORING

model ProctoringEvent {
  id              String        @id @default(ulid())
  organizationId  String
  participantId   String
  contestId       String        // denormalized for fast queries
  type            ViolationType
  severity        Int           @default(1)   // 1=low, 2=medium, 3=high
  metadata        Json?         // e.g. { confidence: 0.92, faceCount: 2 }
  occurredAt      DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?       // adminId who reviewed
  dismissed       Boolean       @default(false)

  // Relations
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant     Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([participantId])
  @@index([contestId, type])
  @@index([contestId, occurredAt])
  @@map("proctoring_events")
}

// Aggregated proctoring score per participant (updated in real-time by worker)
model ProctoringScore {
  id                  String    @id @default(ulid())
  organizationId      String
  participantId       String
  contestId           String
  totalViolations     Int       @default(0)
  highSeverityCount   Int       @default(0)
  violationScore      Decimal   @default(0) @db.Decimal(6, 2)
  trustScore          Decimal   @default(100) @db.Decimal(5, 2)
  isFlagged           Boolean   @default(false)
  flaggedAt           DateTime?
  adminNotes          String?
  updatedAt           DateTime  @updatedAt

  // Relations
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant         Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contest             Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([participantId, contestId])
  @@index([organizationId])
  @@index([contestId, isFlagged])
  @@map("proctoring_scores")
}

// MESSAGING

model MessageLog {
  id              String          @id @default(ulid())
  organizationId  String
  participantId   String?         // null for bulk/broadcast
  contestId       String?
  channel         MessageChannel
  template        String
  params          Json?
  status          MessageStatus   @default(QUEUED)
  recipient       String          // phone number or email address
  subject         String?         // email subject
  body            String?         // rendered message body (for audit)
  metadata        Json?           // template parameters, etc.
  providerMsgId   String?         // Aisensy/SMTP message ID
  sentAt          DateTime?
  deliveredAt     DateTime?
  failureReason   String?
  retryCount      Int             @default(0)
  attemptCount   Int                @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participant     Participant?    @relation(fields: [participantId], references: [id])
  contest         Contest?        @relation(fields: [contestId], references: [id])

  @@index([organizationId])
  @@index([participantId])
  @@index([contestId, template])
  @@index([status, createdAt])
  @@map("message_logs")
}

// SCHEDULED JOBS  (audit trail for BullMQ jobs)
// BullMQ is the source of truth for job execution, but this table
// gives us a queryable audit trail and state for the admin UI.

model ScheduledJob {
  id              String    @id @default(ulid())
  organizationId  String
  contestId       String?
  bullJobId       String?   @unique   // BullMQ job ID
  queue           String    // e.g. "contest-evaluation", "certificate-generation"
  name            String    // e.g. "quiz:start", "reminder:24h"
  payload         Json
  status          JobStatus @default(WAITING)
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  error           String?
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contest         Contest?     @relation(fields: [contestId], references: [id])

  @@index([organizationId])
  @@index([contestId])
  @@index([queue, status])
  @@index([scheduledFor, status])
  @@map("scheduled_jobs")
}

// ANALYTICS SNAPSHOTS  (pre-aggregated, refreshed by worker every 15 min)

model ContestAnalyticsSnapshot {
  id                    String    @id @default(ulid())
  organizationId        String
  contestId             String    @unique
  totalRegistrations    Int       @default(0)
  totalRevenue          Decimal   @default(0) @db.Decimal(12, 2)
  totalParticipated     Int       @default(0)    // actually joined quiz
  totalSubmitted        Int       @default(0)
  avgScore              Decimal?  @db.Decimal(5, 2)
  highestScore          Decimal?  @db.Decimal(5, 2)
  lowestScore           Decimal?  @db.Decimal(5, 2)
  medianScore           Decimal?  @db.Decimal(5, 2)
  avgTimeTakenSecs      Int?
  fastestTimeSecs       Int?      // MIN(timeTakenSecs) across EVALUATED submissions
  slowestTimeSecs       Int?      // MAX(timeTakenSecs) across EVALUATED submissions
  passingCount          Int?      // EVALUATED submissions with percentage >= Contest.cutoffScore
  failingCount          Int?      // EVALUATED submissions with percentage < Contest.cutoffScore
  activeNow             Int       @default(0)    // updated from Redis heartbeat
  snapshotAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contestId])
  @@map("contest_analytics_snapshots")
}

// EXPORT LOGS

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportLog {
  id              String       @id @default(ulid())
  organizationId  String
  contestId       String
  adminId         String
  format          String       // "csv" or "pdf"
  status          ExportStatus @default(PENDING)
  progress        Int          @default(0) // 0 to 100
  fileUrl         String?
  fileKey         String?
  filters         Json?
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contest         Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  admin           Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contestId])
  @@index([adminId])
  @@map("export_logs")
}

// ORGANIZATION ONBOARDING PROFILE
// Captures enrichment data collected during the post-signup wizard.
// Stored separately to keep the hot-path Organization row lean.

model OrganizationProfile {
  id                       String                    @id @default(ulid())
  organizationId           String                    @unique
  primaryUseCase           OrgPrimaryUseCase?
  useCaseOther             String?                   // filled when primaryUseCase = OTHER
  sizeBucket               OrgSizeBucket?
  expectedContestsPerMonth ExpectedContestVolume     @default(UNSURE)
  expectedParticipants     ExpectedParticipantVolume @default(UNSURE)
  heardAboutSource         HeardAboutSource?
  heardAboutOther          String?                   // filled when heardAboutSource = OTHER
  primaryContactName       String?
  primaryContactPhone      String?
  primaryContactEmail      String?
  country                  String?
  state                    String?
  city                     String?
  timezone                 String?
  preferredCurrency        String                    @default("INR")
  gstNumber                String?
  billingAddress           String?
  marketingOptIn           Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([primaryUseCase])
  @@index([sizeBucket])
  @@index([heardAboutSource])
  @@map("organization_profiles")
}

// FEATURE FLAGS
// Global default + per-organization override, mirroring quizbuzz-ops-next's
// own FeatureFlag / FeatureFlagOrgOverride models 1:1. Deliberately minimal
// here — no label/description/severity/reason/createdByName/soft-delete
// bookkeeping. That history of record (who toggled what, when, why) lives in
// ops's own tables and PlatformAuditLog. This side only ever needs to answer
// "is `key` currently on for this org (or globally)" — see
// src/common/feature-flags.ts's isFeatureEnabled(). Written to by ops via
// queryMainDb (same connection/pattern entitlements.repository.ts already
// uses), read by this app's own Prisma client on its own connection.

model PlatformFeatureFlag {
  key       String   @id
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("platform_feature_flags")
}

model OrganizationFeatureFlagOverride {
  key            String
  organizationId String
  isEnabled      Boolean
  expiresAt      DateTime?
  updatedAt      DateTime  @updatedAt

  @@id([key, organizationId])
  @@index([key, organizationId])
  @@map("organization_feature_flag_overrides")
}

// AMBASSADOR PROGRAM

model Ambassador {
  id                String            @id @default(ulid())
  organizationId    String
  email             String
  phone             String?
  firstName         String
  lastName          String?
  ambassadorType    String            // PlatformAmbassadorType.key — validated at application time, not a DB FK
  applicationData   Json              @default("{}")   // type-specific answers, keyed by that type's applicationFields[].key
  status            AmbassadorStatus  @default(PENDING)
  proofStorageKey   String
  proofUrl          String
  appliedAt         DateTime          @default(now())
  reviewedAt        DateTime?
  reviewedById      String?
  rejectionReason   String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments       AmbassadorCampaignEnrollment[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("ambassadors")
}

model AmbassadorCampaign {
  id                      String                    @id @default(ulid())
  organizationId          String
  contestId               String
  name                    String
  ambassadorTypesAllowed  String[]
  rewardConfig            Json                       // see ambassador-campaign.types.ts RewardConfig
  shareTemplates          Json      @default("{}")   // { whatsappText, instagramText, posterImageUrl }
  sourceCampaignId        String?
  status                  AmbassadorCampaignStatus  @default(ACTIVE)
  createdById             String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contest                 Contest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  enrollments             AmbassadorCampaignEnrollment[]

  @@unique([contestId])
  @@index([organizationId, status])
  @@map("ambassador_campaigns")
}

model AmbassadorCampaignEnrollment {
  id              String     @id @default(ulid())
  campaignId      String
  ambassadorId    String
  referralCode    String     @unique
  createdAt       DateTime   @default(now())

  campaign        AmbassadorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ambassador      Ambassador         @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referrals       Participant[]      @relation("ReferredBy")

  @@unique([campaignId, ambassadorId])
  @@index([referralCode])
  @@map("ambassador_campaign_enrollments")
}

// Read-only mirror of quizbuzz-ops-next's AmbassadorType catalog — quizbuzz-ops-next writes these two
// tables via a fire-and-forget raw-SQL write-through on every type create/edit/toggle (same mechanism as
// platform_feature_flags above — see src/common/feature-flags.ts). This app only ever reads these tables.
model PlatformAmbassadorType {
  key               String   @id
  label             String
  proofFieldLabel   String
  applicationFields Json     // array of { key, label, type, required, options? }
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  @@map("platform_ambassador_types")
}

model OrganizationAmbassadorTypeAccess {
  organizationId String
  typeKey        String
  isEnabled      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, typeKey])
  @@map("organization_ambassador_type_access")
}
