# ----------------------------------------------------------------------------
# TEST ENVIRONMENT CONFIG
#
# Loaded automatically when NODE_ENV=test (see src/config/index.ts).
# Jest sets NODE_ENV=test by default, so this applies both locally and in CI.
#
# All values below are dummy/fake — safe to commit. No real secrets, no
# live payment/messaging credentials. Unit tests should never touch real
# infrastructure; anything that needs real Redis/Postgres belongs in an
# integration-test suite with its own setup, not this file.
# ----------------------------------------------------------------------------

# APP CONFIG
NODE_ENV=test
APP_NAME=QuizBuzz Test
PORT=5002
BASE_URL=http://localhost:5002/api
FRONTEND_URL=http://localhost:3000

# Instance scaling
INSTANCE_ID=test-instance-1
INSTANCE_COUNT=1

# DATABASE CONFIG
DATABASE_URL="postgresql://test:test@localhost:5432/quizbuzz_test?schema=public"
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_QUERY_TIMEOUT=5000

# REDIS CONFIG
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_MAX_RETRIES=5
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

REDIS_CLUSTER_ENABLED=false

# REDIS TTLs
QUIZ_SESSION_TTL=7200
HEARTBEAT_TTL=30
SOCKET_TOKEN_TTL=7200
OTP_TTL=300
IDEMPOTENCY_TTL=86400

# WEBSOCKET CONFIG
WS_NAMESPACE=/quiz
WS_PATH=/socket.io
WS_HEARTBEAT_INTERVAL=15000
WS_CONNECTION_TIMEOUT=30000
WS_MAX_CONNECTIONS_PER_INSTANCE=1000

WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=2000

# AUTH CONFIG
JWT_ACCESS_SECRET=test_access_secret_do_not_use_in_prod
JWT_REFRESH_SECRET=test_refresh_secret_do_not_use_in_prod
JWT_CONTACT_SECRET=test_contact_secret_do_not_use_in_prod

JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800
JWT_CONTACT_TTL=900

# cookie config
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# OTP CONFIG
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=5
OTP_SECRET=test_otp_secret_do_not_use

# RATE LIMITING
RATE_LIMIT_WINDOW=600
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=10
RATE_LIMIT_OTP=5

# QUEUE
QUEUE_REDIS_DB=1
QUEUE_PREFIX=quizbuzz_test

QUEUE_CONCURRENCY=5
QUEUE_RETRY_ATTEMPTS=3
QUEUE_BACKOFF_TYPE=exponential
QUEUE_BACKOFF_DELAY=1000

# Worker Scaling
WORKER_INSTANCES=1

# PAYMENT (Razorpay) — dummy test-mode values, never live keys
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=rzp_test_dummy_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_dummy_webhook_secret

# Route payout fee split (config-driven, no magic numbers in code)
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_ROUTE_ONBOARDING_MODE=MANUAL
PLATFORM_COMMISSION_PERCENT=2
RAZORPAY_GATEWAY_FEE_PERCENT=2
RAZORPAY_GST_ON_FEE_PERCENT=18
RAZORPAY_ROUTE_TRANSFER_DELAY_MS=300000

# MESSAGING
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
EMAIL_FROM=test@quizbuzz.test

# Whatsapp
AISENSY_API_URL=https://api.aisensy.test
AISENSY_API_KEY=test_aisensy_key

# FEATURE FLAGS
ENABLE_PROCTORING=false
ENABLE_ANALYTICS=true
ENABLE_CERTIFICATES=true
ENABLE_NOTIFICATIONS=true

# ANALYTICS CONFIG
ANALYTICS_SNAPSHOT_INTERVAL=60
ANALYTICS_RETENTION_DAYS=30

# PUB/SUB CHANNELS
REDIS_PUBSUB_ENABLED=true
REDIS_PUBSUB_PREFIX=quizbuzz_test

# SCALING LIMITS
MAX_PARTICIPANTS_PER_CONTEST=10000
MAX_QUESTIONS_PER_CONTEST=200
MAX_CONCURRENT_CONTESTS=10

# SECURITY CONFIG
BCRYPT_SALT_ROUNDS=4
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOW_CREDENTIALS=true

# IDEMPOTENCY
IDEMPOTENCY_ENABLED=true

# FILE STORAGE (S3 / CDN)
STORAGE_PROVIDER=local

# PROCTORING CONFIG
PROCTORING_EVENT_THRESHOLD=5
PROCTORING_STRICT_MODE=false

# HEALTH & MONITORING
HEALTHCHECK_ENABLED=true
METRICS_ENABLED=false

# LOGGING
LOG_LEVEL=error
LOG_FORMAT=json

# TESTING / DEBUG FLAGS
ENABLE_DEBUG_LOGS=false
MOCK_PAYMENT=true

# TIMEOUTS
API_TIMEOUT=10000
DB_TIMEOUT=5000
REDIS_TIMEOUT=5000

# CONTEST CONTROL
QUIZ_AUTO_SUBMIT=true
QUIZ_TIME_WARNING_1=600
QUIZ_TIME_WARNING_2=300
QUIZ_TIME_WARNING_3=60

# Sentry & Posthog — disabled/dummy in test
APP_VERSION=test
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

POSTHOG_API_KEY=test_posthog_key
POSTHOG_HOST=https://us.i.posthog.com

POSTHOG_FLUSH_AT=20
POSTHOG_FLUSH_INTERVAL=30000

########################################
# DURABILITY (Redis snapshot + recovery)

DURABILITY_SNAPSHOT_INTERVAL_MINUTES=5
DURABILITY_SNAPSHOT_BATCH_SIZE=300
DURABILITY_SNAPSHOT_BATCH_CONCURRENCY=4

# Transaction-level timeouts for submission writes — generous enough to absorb
# a legitimate DB pool burst (e.g. mass AUTO_SUBMIT) without false-failing.
DB_TRANSACTION_MAX_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=10000

# Redis lock TTL guarding submitQuiz() against duplicate/concurrent submissions.
QUIZ_SUBMISSION_LOCK_TTL_MS=15000

