# RDS PROXY — Phase 1 of the join-flow scaling plan
# (see claude/join-flow-scaling-and-prefill-implementation-plan.md)
#
# WHY: DB_POOL_MAX per app instance was sized against RDS's own
# ~85 max_connections, which only holds if the number of running app
# instances stays fixed (see the comment in
# terraform/modules/live_contest/userdata.sh.tpl: "With up to 5 instances:
# floor(85/5)=17, set to 15" — but the load-test plan now scales to 10).
# RDS Proxy multiplexes many app-side connections onto a small, stable
# number of real Postgres connections, so pool sizing no longer depends
# on instance count.
#
# PURELY ADDITIVE: the RDS instance itself (aws_db_instance.postgres —
# instance class, storage, its own security group, subnets) is completely
# untouched by this file. Nothing here modifies it. Cutover is a manual
# DATABASE_URL swap in SSM, same manual step already documented for the
# instance's own endpoint below in main.tf — not a Terraform-managed value,
# so applying this file alone does not change what any running instance
# connects to until that SSM parameter is updated by hand.

variable "rds_proxy_sg_id" {
  description = "Security group ID for the RDS Proxy (allows EC2 SG in on 5432) — from module.networking.rds_proxy_sg_id"
  type        = string
}

# RDS Proxy requires its DB credentials in Secrets Manager — this is an
# AWS requirement for how the proxy authenticates to Postgres, not a
# design choice made here. Mirrors the same var.db_password already used
# by aws_db_instance.postgres above, so the two can never drift.
resource "aws_secretsmanager_secret" "rds_proxy_auth" {
  name        = "quizbuzz/prod/rds-proxy-db-auth"
  description = "DB credentials for RDS Proxy auth — kept in sync with aws_db_instance.postgres via the same db_password input"
}

resource "aws_secretsmanager_secret_version" "rds_proxy_auth" {
  secret_id = aws_secretsmanager_secret.rds_proxy_auth.id
  secret_string = jsonencode({
    username = aws_db_instance.postgres.username
    password = var.db_password
  })
}

resource "aws_iam_role" "rds_proxy" {
  name = "quizbuzz-rds-proxy-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "rds.amazonaws.com" }
    }]
  })

  tags = { Name = "quizbuzz-rds-proxy-role" }
}

resource "aws_iam_role_policy" "rds_proxy_secrets" {
  name = "quizbuzz-rds-proxy-secrets-access"
  role = aws_iam_role.rds_proxy.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["secretsmanager:GetSecretValue"]
      Resource = aws_secretsmanager_secret.rds_proxy_auth.arn
    }]
  })
}

resource "aws_db_proxy" "postgres" {
  name                   = "quizbuzz-rds-proxy"
  engine_family          = "POSTGRESQL"
  role_arn               = aws_iam_role.rds_proxy.arn
  vpc_subnet_ids         = var.public_subnets
  vpc_security_group_ids = [var.rds_proxy_sg_id]

  # Conservative default: don't idle-close borrowed connections too
  # aggressively during a live contest's long hold periods.
  idle_client_timeout = 1800

  auth {
    auth_scheme = "SECRETS"
    secret_arn  = aws_secretsmanager_secret.rds_proxy_auth.arn
    iam_auth    = "DISABLED"
  }

  tags = { Name = "quizbuzz-rds-proxy" }
}

resource "aws_db_proxy_default_target_group" "postgres" {
  db_proxy_name = aws_db_proxy.postgres.name

  connection_pool_config {
    max_connections_percent      = 100
    max_idle_connections_percent = 50
  }
}

resource "aws_db_proxy_target" "postgres" {
  db_proxy_name          = aws_db_proxy.postgres.name
  target_group_name      = aws_db_proxy_default_target_group.postgres.name
  db_instance_identifier = aws_db_instance.postgres.identifier
}

output "proxy_endpoint" {
  value       = aws_db_proxy.postgres.endpoint
  description = "RDS Proxy endpoint. Cutover: manually update the /quizbuzz/prod/DATABASE_URL SSM parameter to use this host instead of db_endpoint — same manual step already used for the instance's own endpoint (see main.tf). Nothing reads this automatically."
}
